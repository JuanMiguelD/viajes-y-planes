rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // La lista de correos con acceso NO está en el código (el repo es público): vive en el
    // documento config/acceso, campo "correos" (array), que se edita solo desde la consola.
    function isCouple() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in get(/databases/$(database)/documents/config/acceso).data.correos;
    }

    match /plans/{planId} {
      allow read, write: if isCouple();
    }

    // La app lee este documento (aunque no exista) justo después del login para saber
    // si la cuenta tiene acceso; si no lo tiene, la expulsa.
    match /access/check {
      allow get: if isCouple();
    }

    // Colores y etiquetas de tipo de lugar: compartidos entre los dos desde Ajustes.
    match /config/settings {
      allow read, write: if isCouple();
    }

    // Juegos: la mesa es de los dos. La palabra secreta de Palabritas va aparte y solo la
    // puede leer quien la eligió; solo la puede escribir quien tiene el turno de elegirla.
    match /games/{game} {
      allow read, write: if isCouple();

      match /private/secret {
        allow read: if isCouple() && resource.data.setterUid == request.auth.uid;
        allow create, update: if isCouple()
          && request.resource.data.setterUid == request.auth.uid
          && get(/databases/$(database)/documents/games/$(game)).data.setterUid == request.auth.uid;
      }
    }

    // Todo lo demás, incluida config/acceso, queda cerrado para la app.
  }
}
