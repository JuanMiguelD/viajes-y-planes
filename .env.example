# Copia este archivo a .env.local y rellénalo con la config de tu app web de Firebase
# (Consola de Firebase → Configuración del proyecto → Tus apps → SDK setup and configuration).
# Si lo dejas vacío, la app funciona en modo local (localStorage, sin fotos).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# API key de Google Maps para la pestaña "Mapa" (https://console.cloud.google.com/):
# 1. Crea un proyecto y habilita la API "Maps JavaScript API".
# 2. Activa la facturación del proyecto (Google la exige aunque el uso de esta app
#    se mantenga dentro de su nivel gratuito).
# 3. Crea una API key y, por seguridad, restríngela al dominio donde publiques la app.
# Si lo dejas vacío, la pestaña de mapa avisa que falta la key pero el resto de la app funciona igual.
VITE_GOOGLE_MAPS_API_KEY=
